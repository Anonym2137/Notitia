# ===========================================
# Notitia - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# --- Supabase ---
DATABASE_URL='postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true'
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- E2 Object Storage (main media bucket) ---
NEXT_PUBLIC_E2_ENDPOINT=your-e2-endpoint.example.com
NEXT_PUBLIC_E2_BUCKET_NAME=your-bucket-name
E2_ACCESS_KEY_ID=your-access-key
E2_SECRET_ACCESS_KEY=your-secret-key

# --- E2 Object Storage (user avatars bucket) ---
NEXT_PUBLIC_E2_AVATARS_BUCKET_NAME=your-avatars-bucket-name
E2_AVATARS_ACCESS_KEY_ID=your-avatars-access-key
E2_AVATARS_SECRET_ACCESS_KEY=your-avatars-secret-key

# --- TMDB (The Movie Database) ---
TMDB_ACCESS_KEY_ID=your-tmdb-access-token
TMDB_API_KEY=your-tmdb-api-key
